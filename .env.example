# Ключ Gemini API: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here
GEMINI_MODEL=gemini-3.8-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Необязательно: модель и пауза между запросами (сек) под лимиты бесплатного тарифа.
# Можно указать несколько моделей через запятую: следующая берётся, когда у предыдущей
# исчерпана квота или модель недоступна (у каждой модели своя квота). Имена смотрите в Google AI Studio.
# GEMINI_MODEL=gemini-3.8-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
# LLM_MIN_INTERVAL=4
